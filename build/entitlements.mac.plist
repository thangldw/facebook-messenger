<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Hardened runtime entitlements for the app and its helpers. The hardened runtime
  makes macOS ignore DYLD_* environment variables and refuse debugger attachment,
  so another program running as you cannot inject code to read the session.
  Only what Electron and calls need is granted: no allow-dyld-environment-variables,
  no get-task-allow. disable-library-validation is required because the builds are
  ad-hoc signed: with no Team ID, library validation would refuse to load Electron's
  own frameworks (electron-builder warns about this). DYLD_* variables stay ignored.
-->
<plist version="1.0">
  <dict>
    <!-- V8 compiles JavaScript at runtime. -->
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
    <!-- Ad-hoc signing (see above). -->
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>
    <!-- Calls: without these the hardened runtime blocks the microphone and camera. -->
    <key>com.apple.security.device.audio-input</key>
    <true/>
    <key>com.apple.security.device.camera</key>
    <true/>
  </dict>
</plist>
