{
  "name": "messenger-lite",
  "productName": "Messenger Lite",
  "version": "0.2.0",
  "description": "Desktop app for Facebook Messenger with the News Feed blocked",
  "main": "src/main.js",
  "private": true,
  "author": "Thang <thangldw@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/thangldw/facebook-messenger.git"
  },
  "scripts": {
    "start": "electron .",
    "test": "node --test",
    "app:mac": "electron-builder --mac dir",
    "dist": "electron-builder --publish never",
    "dist:mac": "electron-builder --mac --publish never",
    "dist:win": "electron-builder --win --publish never",
    "dist:linux": "electron-builder --linux --publish never"
  },
  "devDependencies": {
    "electron": "45.4.1",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "local.personal.messenger-lite",
    "files": [
      "src/**/*",
      "package.json"
    ],
    "directories": {
      "buildResources": "build"
    },
    "electronFuses": {
      "enableCookieEncryption": true,
      "runAsNode": false,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true,
      "grantFileProtocolExtraPrivileges": false
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "category": "public.app-category.social-networking",
      "identity": "-",
      "hardenedRuntime": false,
      "artifactName": "MessengerLite-${version}-mac-${arch}.${ext}",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Messenger calls need the microphone.",
        "NSCameraUsageDescription": "Messenger video calls need the camera."
      }
    },
    "win": {
      "target": [
        "zip",
        "nsis"
      ],
      "artifactName": "MessengerLite-${version}-win-${arch}.${ext}"
    },
    "nsis": {
      "artifactName": "MessengerLite-${version}-win-${arch}-setup.${ext}"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Network",
      "maintainer": "Thang <thangldw@gmail.com>",
      "synopsis": "Facebook Messenger without the News Feed",
      "artifactName": "MessengerLite-${version}-linux-${arch}.${ext}"
    }
  },
  "homepage": "https://github.com/thangldw/facebook-messenger"
}
